<div class="chat-container">
  <div class="chat-window" id="chatWindow">
    <div class="chat-message-container">
      <div class="chat-message ai-message">
        <div class="message-bubble">
          <p>数学に関することならなんでも聞いてください！</p>
        </div>
      </div>
    </div>
  </div>
  <div class="chat-input-area">
    <input type="text" id="promptInput" placeholder="質問を入力してください" size="40">
    <button id="callGeminiBtn">送信</button>
  </div>
</div>

<style>
  .chat-container {
    max-width: 800px;
    margin: 20px auto;
    border: 3px solid #000; /* 黒 */
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 70vh; 
    background-color: #949593;
  }

  .chat-window {
    flex-grow: 1;
    padding: 20px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  .chat-message-container {
    margin-bottom: 15px;
    display: flex;
    flex-direction: column;
  }

  .chat-message {
    display: flex;
    margin-bottom: 10px;
  }

  .user-message {
    justify-content: flex-end;
  }

  .ai-message {
    justify-content: flex-start;
  }

  .message-bubble {
    max-width: 70%;
    padding: 10px 15px;
    border-radius: 20px;
    color: white;
    line-height: 1.5;
  }

  .user-message .message-bubble {
    background-color: #000; /* 黒 */
    color: white;
    border-bottom-right-radius: 5px;
  }

  .ai-message .message-bubble {
    background-color: #d30001; /* 赤 */
    color: white;
    border-bottom-left-radius: 5px;
  }

  .message-bubble p {
    margin: 0;
  }
  
  .loading-message .message-bubble {
    background-color: #ccc;
    color: #333;
  }

  .chat-input-area {
    padding: 10px;
    border-top: 3px solid #000; /* 黒 */
    background-color: #949593;
    display: flex;
  }

  #promptInput {
    flex-grow: 1;
    border: 1px solid #ccc;
    border-radius: 20px;
    padding: 10px 15px;
    margin-right: 10px;
  }

  #callGeminiBtn {
    background-color: #ffd700; /* 金色 */
    color: #000; /* 黒 */
    border: none;
    padding: 10px 20px;
    border-radius: 20px;
    cursor: pointer;
    font-weight: bold;
    transition: background-color 0.3s;
  }

  #callGeminiBtn:hover {
    background-color: #e6c300; /* 少し暗い金色 */
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const promptInput = document.getElementById('promptInput');
  const callGeminiBtn = document.getElementById('callGeminiBtn');
  const chatWindow = document.getElementById('chatWindow');

  const appendMessage = (message, sender) => {
    const messageContainer = document.createElement('div');
    messageContainer.className = 'chat-message-container';

    const messageElement = document.createElement('div');
    messageElement.className = `chat-message ${sender}-message`;

    const bubble = document.createElement('div');
    bubble.className = 'message-bubble';
    
    const p = document.createElement('p');
    p.textContent = message;
    
    bubble.appendChild(p);
    messageElement.appendChild(bubble);
    messageContainer.appendChild(messageElement);
    chatWindow.appendChild(messageContainer);

    // 自動で一番下までスクロール
    chatWindow.scrollTop = chatWindow.scrollHeight;
    
    return messageContainer; // ローディング表示の更新用に要素を返す
  };

  const callApi = async () => {
    const prompt = promptInput.value.trim();
    if (prompt === '') return;

    appendMessage(prompt, 'user');
    promptInput.value = '';

    // ローディングメッセージを追加
    const loadingMessageContainer = appendMessage('...', 'ai');
    loadingMessageContainer.querySelector('.chat-message').classList.add('loading-message');


    try {
      const response = await fetch('/gemini', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content')
        },
        body: JSON.stringify({ prompt: prompt })
      });

      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }

      const data = await response.json();
      const aiResponse = data.response.text;
      
      const loadingBubble = loadingMessageContainer.querySelector('.message-bubble p');
      loadingBubble.textContent = aiResponse;
      loadingMessageContainer.querySelector('.chat-message').classList.remove('loading-message');
      
      chatWindow.scrollTop = chatWindow.scrollHeight;

    } catch (error) {
      console.error('Error calling Gemini API:', error);
      const errorBubble = loadingMessageContainer.querySelector('.message-bubble p');
      errorBubble.textContent = 'エラーが発生しました。';
      loadingMessageContainer.querySelector('.chat-message').classList.remove('loading-message');
    }
  };

  callGeminiBtn.addEventListener('click', callApi);
  promptInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
      callApi();
    }
  });

  // === ここから追加したコード ===
  const urlParams = new URLSearchParams(window.location.search);
  const autoPrompt = urlParams.get('question');
  if (autoPrompt) {
    // 入力欄に自動で値をセット
    promptInput.value = autoPrompt;
    // 自動で送信ボタンをクリックして処理を開始
    callGeminiBtn.click();
  }
  // === ここまで追加したコード ===
});
</script>