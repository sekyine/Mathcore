<head>
  <meta name="csrf-token" content="<%= form_authenticity_token %>">
</head>
<h1>GeminiTest</h1>
<input type="text" id="promptInput" placeholder="プロンプトを入力してください" size="40">
<button id="callGeminiBtn">送信</button>

<h2>会話:</h2>
<div id="conversationHistory"></div>

<script>
  // 送信ボタンのクリックイベント処理
  document.getElementById("callGeminiBtn").addEventListener("click", () => {
    const promptInput = document.getElementById("promptInput");
    const prompt = promptInput.value;
  
    fetch("http://127.0.0.1:3000/gemini", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || ""
      },
      // API送信用のプロンプトは内部変数（例：aggregatedPrompt）を使うか、最新の入力のみ送るか
      body: JSON.stringify({ prompt: prompt })
    })
    .then(res => res.json())
    .then(data => {
      const conversationHistory = document.getElementById("conversationHistory");
      const resultText = data.response.text;
  
      // 画面に追加するのは最新の発言のみ（履歴は内部管理）
      const userMessage = `<p><strong>ユーザー:</strong> ${prompt}</p>`;
      conversationHistory.insertAdjacentHTML('beforeend', userMessage);
  
      const aiMessage = `<p><strong>AI:</strong> ${resultText}</p>`;
      conversationHistory.insertAdjacentHTML('beforeend', aiMessage);
  
      // 送信後、入力欄を空に
      promptInput.value = "";
    })
    .catch(error => {
      document.getElementById("conversationHistory")
        .insertAdjacentHTML('beforeend', `<p style="color: red;">エラー: ${error}</p>`);
    });
  });
</script>


