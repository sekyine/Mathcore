<div data-controller="gemini-chat" class="chat-container">
  <div class="chat-header">
    <h2>Gemini AI チャット</h2>
  </div>
  <div class="chat-messages" data-gemini-chat-target="messages">
    <div class="message-row ai-message">
      <div class="message-bubble">
        <p>数学に関することならなんでも聞いてください！</p>
      </div>
    </div>
  </div>
  <div class="chat-input-area">
    <form data-action="submit->gemini-chat#sendMessage" data-gemini-chat-target="form" class="chat-form">
      <input type="text" data-gemini-chat-target="input" class="form-control" placeholder="メッセージを入力...">
      <button type="submit" class="btn btn-primary">送信</button>
    </form>
  </div>
</div>