<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Mathcore" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-..." crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="https://use.fontawesome.com/releases/v5.6.1/css/all.css" rel="stylesheet">
  
    <%= audio_tag "bgm.mp3", loop: true, id: "bgm" %>
    </head>

   <body style="background-color: #1c1c1c; color: #f5f5dc; font-family: 'Helvetica Neue', sans-serif;">
    
    
    <%= render 'layouts/header' %>  
    <% flash.each do |message_type, message| %> 
      <%= message %> 
    <% end %> 
    
    <%= yield %> 
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  
      <script>
        document.addEventListener("DOMContentLoaded", function () {
          const toastElement = document.getElementById("answerToast");
          const toastBody = document.getElementById("toastBody");
          const toast = new bootstrap.Toast(toastElement);

          document.querySelectorAll(".answer-btn").forEach(function (btn) {
            btn.addEventListener("click", function () {
              const isCorrect = btn.dataset.answer === "true";
              if (isCorrect) {
                toastBody.textContent = "正解！";
                toastElement.classList.remove("bg-danger");
                toastElement.classList.add("bg-success");
              } else {
                toastBody.textContent = "不正解…";
                toastElement.classList.remove("bg-success");
                toastElement.classList.add("bg-danger");
              }
              toast.show();
            });
          });
        });
      </script>

      <script>
        document.addEventListener('DOMContentLoaded', () => {
          document.querySelectorAll('.answer-btn').forEach(button => {
            button.addEventListener('click', () => {
              const isCorrect = button.dataset.answer === 'true';
              const resultId = button.dataset.resultId;
              const resultElement = document.getElementById(resultId);

              if (resultElement) {
                resultElement.textContent = isCorrect ? '正解！' : '不正解…';
                resultElement.className = isCorrect
                  ? 'fw-bold text-center text-success'
                  : 'fw-bold text-center text-danger';
              }
            });
          });
        });

        document.body.addEventListener('click', () => {
      const bgm = document.getElementById('bgm');
      // muted属性をtrueにすることで、多くの場合自動再生が可能になります。
      // ユーザーがクリックしたら音量を元に戻して再生します。
      if (bgm.paused) {
        bgm.play().catch(e => {
          console.error("音声の再生に失敗しました:", e);
        });
      }
    }, { once: true });
      </script>

      <script>
        document.addEventListener('turbo:load', () => {
          // BGMのaudio要素を取得
          const bgm = document.getElementById('bgm');
          
          // audio要素が存在する場合のみ処理を実行
          if (bgm) {
            // ページ上のどこかがクリックされた最初の1回だけ、以下の処理を実行
            const playBgm = () => {
              // 音声がまだ再生されていない場合のみ再生
              if (bgm.paused) {
                bgm.play().catch(e => {
                  // ユーザーが操作する前に再生しようとするとエラーが出ることがあるため、コンソールに出力
                  console.error("BGMの再生に失敗しました:", e);
                });
              }
              // 2回目以降のクリックで再度この関数が呼ばれないようにイベントリスナーを削除
              document.body.removeEventListener('click', playBgm);
            };

            document.body.addEventListener('click', playBgm);
          }
        });
      </script>
    </body>

  
</html>
