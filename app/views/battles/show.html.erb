<style>
  @import url('https://fonts.googleapis.com/css2?family=DotGothic16&display=swap');
</style>

<div class="container mt-4">
  <div class="row text-center mb-3">
    <div class="col-6">
      <h2>ターン</h2>
      <p class="h3"><%= @battle.turn %></p>
    </div>
    <div class="col-6">
      <h2>ボスのHP</h2>
      <p class="h3"><%= @battle.boss_hp %></p>
    </div>
  </div>
  <div class="row align-items-center justify-content-center my-4">
    <div class="col-5 text-center">
      <%= image_tag "boss.png", style: "max-width: 150px; height: auto;" %>
      <p class="mt-2 text-white">ボス</p>
    </div>

    <div class="col-2 text-center h4 text-white">VS</div>

    <div class="col-5 text-center">
      <%= image_tag @battle.user.image, style: "max-width: 150px; height: auto; border-radius: 50%; border: 3px solid #fff;" %>
      <p class="mt-2 text-white"><%= @battle.user.nickname %></p>
    </div>
  </div>

  <div class="row text-center mb-4">
    <div class="col-12">
      <h2>あなたのHP</h2>
      <p class="h3 text-success"><%= @battle.player_hp %></p>
    </div>
  </div>
  <hr>

  <!--四則演算ダンジョンの時だけ表示-->
  <% if ["四則演算ダンジョン","法廷","双眸を為す"].include?(@battle.dungeon&.name) && @current_weak_bunyas.present? %>
      <div class="alert alert-warning text-center" role="alert">
        現在の弱点分野：<strong><%= @current_weak_bunyas.join('、') %></strong>
      </div>
  <% end %>

  <h3 class="mb-3 text-white">あなたの手札</h3>

  <div class="d-flex flex-row flex-nowrap overflow-auto gap-3 pb-3">
    <% @battle.player_hand.each_with_index do |card_id, index| %>
      <% card = Card.find(card_id) %>

      <div class="card bg-dark text-white battle-card" style="width: 8rem; min-width: 8rem;">
        <%= image_tag card.image, class: "card-img-top", style: "height: 135px; object-fit: cover;" %>
        <div class="card-body p-2">

          <p class="card-text mb-1 <%= 'text-danger' if @current_weak_bunyas.present? && @current_weak_bunyas.include?(card.bunya.strip) %>">
            <%= card.bunya %>
          </p>
          <p class="card-text small mb-2">（<%= card.effect_type %>: <%= effective_power_with_base(card, current_user) %>）</p>
          <% if not @victory || @defeat %>
          <button type="button" class="btn btn-outline-light btn-sm w-100"
                  data-bs-toggle="modal"
                  data-bs-target="#cardModal<%= index %>"
                  data-turbo="false">
            問題を解く！
          </button>
          <% end %>
        </div>
      </div>

      <div class="modal fade" id="cardModal<%= index %>" tabindex="-1" aria-labelledby="cardModalLabel<%= index %>" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content text-dark">
            <div class="modal-header">
              <h5 class="modal-title" id="cardModalLabel<%= index %>">問題</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <%= image_tag card.image, class: "img-fluid mb-3" %>
              <p><strong>レア度:</strong> <%= card.st %> ⭐</p>
              <p><strong>分野:</strong> <%= card.bunya %></p>
              <hr>
              <p><strong>問題:</strong> <%= card.question %></p>
              <p><strong>回答:</strong></p>
              <%
                answers = [
                  { text: card.imans1, correct: false },
                  { text: card.imans2, correct: false },
                  { text: card.ans,    correct: true  },
                  { text: card.imans3, correct: false }
                ].shuffle
              %>
              <div class="d-grid gap-2">
                <% answers.each do |ans| %>
                  <%= form_with url: play_battle_path(@battle), method: :post, local: true do %>
                    <%= hidden_field_tag :card_id, card.id %>
                    <%= hidden_field_tag :correct, ans[:correct] %>
                    <button type="submit" class="btn btn-secondary answer-btn w-100">
                      <%= ans[:text] %>
                    </button>
                  <% end %>
                <% end %>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">閉じる</button>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <hr>

  <h3 class="text-white">ログ</h3>
  <div class="rpg-message-window">
    <% @battle.log.last(5).each do |message| %>
      <p class="log-message"><%= message %></p>
    <% end %>
  </div>

  <h3 class="text-white mt-4">Debug</h3>
  <pre style="color:white">player_hand: <%= @battle.player_hand %></pre>
  <pre style="color:white">deck: <%= @battle.deck %></pre>
</div>

<!-- 勝利モーダル -->
<div class="modal fade" id="victoryModal" tabindex="-1" aria-labelledby="victoryModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-success text-white text-center">
      <div class="modal-header">
        <h5 class="modal-title" id="victoryModalLabel">勝利！</h5>
      </div>
      <div class="modal-body">
        <p>ボスを倒しました！</p>
        <%= image_tag "win.jpg", class: "img-fluid", style: "max-height: 200px;" %>
      </div>
      <div class="modal-footer">
        <%= link_to "トップに戻る", root_path, class: "btn btn-light" %>
      </div>
    </div>
  </div>
</div>

<!-- 敗北モーダル -->
<div class="modal fade" id="defeatModal" tabindex="-1" aria-labelledby="defeatModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-danger text-white text-center">
      <div class="modal-header">
        <h5 class="modal-title" id="defeatModalLabel">敗北…</h5>
      </div>
      <div class="modal-body">
        <p>あなたは倒れてしまった…</p>
        <%= image_tag "lose.jpg", class: "img-fluid", style: "max-height: 200px;" %>
      </div>
      <div class="modal-footer">
        <%= link_to "トップに戻る", root_path, class: "btn btn-light" %>
      </div>
    </div>
  </div>
</div>

<% if @victory %>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const victoryModal = new bootstrap.Modal(document.getElementById('victoryModal'));
      victoryModal.show();
    });
  </script>
<% elsif @defeat %>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const defeatModal = new bootstrap.Modal(document.getElementById('defeatModal'));
      defeatModal.show();
    });
  </script>
<% end %>