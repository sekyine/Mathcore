<div style="margin: 20px; padding: 10px;">
  <h2>カード管理</h2>
</div>


<%= form_with url: import_csv_admin_cards_path, method: :post, local: true, html: { multipart: true } do |form| %>

  <div>
    <%= form.label :csv_file, "CSVファイルを選択" %><br>
    <%= form.file_field :csv_file %>
  </div>

  <div>
    <%= form.check_box :replace_data %>
    <%= form.label :replace_data, "既存のデータを削除して置き換える" %>
  </div>
  <a>(battle_investigatesとbattleに含まれるカードIDに不整合が起きる可能性がある)</a>
  <div>
    <%= form.check_box :replace_data2 %>
    <%= form.label :replace_data2, "battle_investigatesとbattleもついでに削除する" %>
  </div>
  <br>

  <div>
    <%= form.submit "インポート" %>
  </div>

<% end %>