<h1 class="text-center mb-4 text-warning">所持カード一覧</h1>

<% if @user_cards.any? %>
  <div class="container">
    <div class="row row-cols-3 row-cols-md-4 row-cols-lg-5 g-4">
      <% @solved_card_ids = current_user.solved_cards.pluck(:card_id) %>
      <% @user_cards.each_with_index do |uc, index| %>
        <div class="col">
          <div class="card shadow bg-dark text-white h-100 border-warning" style="border-width: 2px;">

            <div class="card-img-top bg-black" style="aspect-ratio: 4 / 5; overflow: hidden;">
              <%= image_tag uc.card.image, style: "width: 100%; height: 100%; object-fit: cover;" %>
            </div>
            <div class="card-body p-2">
              <table class="table table-dark table-bordered table-sm mb-2">
                <tbody>
                  <tr>
                    <th scope="row">レア度</th>
                    <td>
                      <%= safe_join(Array.new(uc.card.st.to_i) { content_tag(:i, '', class: 'fa-solid fa-star text-warning') }) %>
                    </td>
                  </tr>
                  <tr>
                    <th scope="row">枚数</th>
                    <td><%= uc.quantity %> 枚</td>
                  </tr>
                  <tr>
                    <th scope="row">分野</th>
                    <td><%= uc.card.bunya %></td>
                  </tr>
                  <tr>
                    <th scope="row"></th>
                    <td>
                    <% if @solved_card_ids.include?(uc.card.id) %>解答済み<% end %>
                    </td>
                  </tr>
                </tbody>
              </table>


              <button type="button" class="btn btn-outline-light btn-sm w-100"

                      data-bs-toggle="modal"
                      data-bs-target="#cardModal<%= index %>"
                      data-turbo="false">
                問題を解く！
              </button>
            </div>
          </div>
        </div>


        <div class="modal fade" id="cardModal<%= index %>" tabindex="-1" aria-labelledby="cardModalLabel<%= index %>" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-dark">
              <div class="modal-body">
                <%= image_tag uc.card.image, class: "img-fluid mb-3" %>
                <p><strong>問題:</strong> <%= uc.card.question %></p>
                <p><strong>分野:</strong> <%= uc.card.bunya %></p>

                <hr>
                <p>回答を選んでください</p>

                <%
                  answers = [
                    { text: uc.card.ans,    correct: true },
                    { text: uc.card.imans1, correct: false },
                    { text: uc.card.imans2, correct: false },
                    { text: uc.card.imans3, correct: false }
                  ].shuffle
                %>

                <div class="d-grid gap-2 answer-container">
                  <% answers.each do |ans| %>
                    <%= form_with url: answer_card_path, method: :post, local: true do %>
                      <%= hidden_field_tag :card_id, uc.card.id %>
                      <%= hidden_field_tag :correct, ans[:correct] %>
                      <button type="submit" class="btn btn-secondary answer-btn" data-answer="<%= ans[:correct] %>">
                        <%= ans[:text] %>
                      </button>
                    <% end %>
                  <% end %>
                </div>

                <div class="mt-3 text-center">
                  <button type="button"
                          id="showExplanation<%= index %>"
                          class="btn btn-info d-none explanation-btn"
                          data-bs-toggle="modal"
                          data-bs-target="#geminiModal"
                          data-question="<%= uc.card.question %>">
                    解説を表示
                  </button>
                </div>

              </div>
              <div class="modal-footer">
                <p id="result<%= index %>" class="fw-bold text-center me-auto"></p>
                <button type="button" class="btn btn-primary d-none retry-btn">もう一度挑戦する</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">閉じる</button>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <p class="text-center text-muted">まだカードを所持していません。</p>
<% end %>


<div class="modal fade" id="geminiModal" tabindex="-1" aria-labelledby="geminiModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="geminiModalLabel">解説</h5>

        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
      </div>
      <div class="modal-body">
        <iframe id="geminiIframe" src="about:blank" style="width:100%; height:600px; border:0;"></iframe>

      </div>
    </div>
  </div>
</div>

<script>
  const initializeCardModal = (modal) => {
    const answerContainer = modal.querySelector('.answer-container');
    const resultElement = modal.querySelector("[id^='result']");
    const explanationBtn = modal.querySelector(".explanation-btn");
    const retryBtn = modal.querySelector('.retry-btn');
    const originalAnswerHTML = answerContainer.innerHTML;

    const handleAnswerClick = (event) => {
      const button = event.currentTarget;
      const form = button.closest('form');
      const allButtons = modal.querySelectorAll(".answer-btn");
      const isCorrect = button.getAttribute("data-answer") === "true";

      form.submit();

      allButtons.forEach(btn => {
        btn.disabled = true;
        if (btn.getAttribute("data-answer") === "true") {
          btn.classList.remove('btn-secondary');
          btn.classList.add('btn-success');
        } else if (btn === button) {
          btn.classList.remove('btn-secondary');
          btn.classList.add('btn-danger');
        }
      });
      
      if (retryBtn) retryBtn.classList.remove('d-none');

      if (isCorrect) {
        resultElement.textContent = "正解！";
        resultElement.classList.add("text-success");
        resultElement.classList.remove("text-danger");
        explanationBtn.classList.remove("d-none");
        const toastEl = document.getElementById('answerToast');
        if(toastEl) {
          const toast = new bootstrap.Toast(toastEl);
          toast.show();
        }
      } else {
        resultElement.textContent = "不正解！";
        resultElement.classList.add("text-danger");
        resultElement.classList.remove("text-success");
      }
    };

    const resetForRetry = () => {
      if (resultElement) {
        resultElement.textContent = '';
        resultElement.classList.remove('text-success', 'text-danger');
      }
      if (explanationBtn) explanationBtn.classList.add('d-none');
      if (retryBtn) retryBtn.classList.add('d-none');
      
      answerContainer.innerHTML = originalAnswerHTML;
      answerContainer.querySelectorAll(".answer-btn").forEach(button => {
        button.addEventListener('click', handleAnswerClick);
      });
    };

    modal.querySelectorAll(".answer-btn").forEach(button => {
      button.addEventListener('click', handleAnswerClick);
    });
    
    if (retryBtn) retryBtn.addEventListener('click', resetForRetry);
    modal.addEventListener('hidden.bs.modal', resetForRetry);
  };

  const initializePage = () => {
    document.querySelectorAll("[id^='cardModal']").forEach(initializeCardModal);

    const geminiModalEl = document.getElementById("geminiModal");
    if (geminiModalEl) {
      geminiModalEl.addEventListener('hide.bs.modal', () => {
        document.querySelectorAll('.modal.show').forEach(openModal => {
          if (openModal.id !== 'geminiModal') {
            const modalInstance = bootstrap.Modal.getInstance(openModal);
            if (modalInstance) modalInstance.hide();
          }
        });
        document.getElementById("geminiIframe").src = 'about:blank';
      });
    }

    document.querySelectorAll('.explanation-btn').forEach(button => {
      button.addEventListener("click", (event) => {
        event.preventDefault();
        const question = button.getAttribute("data-question");
        document.getElementById("geminiIframe").src = `/gemini/test?question=${encodeURIComponent(question)}`;
      });
    });
  };

  document.addEventListener("turbo:load", initializePage);
  document.addEventListener("DOMContentLoaded", initializePage);
</script>