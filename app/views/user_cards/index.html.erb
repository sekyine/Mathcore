<h1 class="text-center mb-4 text-warning">所持カード一覧</h1>

<% if @user_cards.any? %>
  <div class="container">
    <div class="row row-cols-3 row-cols-md-4 row-cols-lg-5 g-4">
      <% @user_cards.each_with_index do |uc, index| %>
        <div class="col">
          <div class="card shadow bg-dark text-white h-100 border-warning" style="border-width: 2px;">

            <!-- カード画像 -->
            <div class="card-img-top d-flex align-items-center justify-content-center bg-black" style="aspect-ratio: 4 / 5;">
              <%= image_tag uc.card.image, style: "max-height: 100%; max-width: 100%; object-fit: contain;" %>
            </div>

            <!-- カード情報 -->
            <div class="card-body p-2">
              <table class="table table-dark table-bordered table-sm mb-2">
                <tbody>
                  <tr>
                    <th scope="row">レア度</th>
                    <td>
                      <%= safe_join(Array.new(uc.card.st) { content_tag(:i, '', class: 'fa-solid fa-star text-warning') }) %>
                    </td>
                  </tr>
                  <tr>
                    <th scope="row">枚数</th>
                    <td><%= uc.quantity %> 枚</td>
                  </tr>
                  <tr>
                    <th scope="row">分野</th>
                    <td><%= uc.card.bunya %></td>
                  </tr>
                </tbody>
              </table>

              <!-- 問題解答用モーダルを開くボタン -->
              <button type="button" class="btn btn-outline-light btn-sm w-100" 
                      data-bs-toggle="modal" 
                      data-bs-target="#cardModal<%= index %>" 
                      data-turbo="false">
                問題を解く！
              </button>
            </div>
          </div>
        </div>

        <!-- 問題解答用モーダル -->
        <div class="modal fade" id="cardModal<%= index %>" tabindex="-1" aria-labelledby="cardModalLabel<%= index %>" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-dark">
              <div class="modal-body">
                <%= image_tag uc.card.image, class: "img-fluid mb-3" %>
                <p><strong>レア度:</strong> <%= uc.card.st %> ⭐</p>
                <p><strong>枚数:</strong> <%= uc.card.question %> 枚</p>
                <p><strong>分野:</strong> <%= uc.card.bunya %></p>
                <p>回答</p>

                <% 
                  answers = [
                    { text: uc.card.imans1, correct: false },
                    { text: uc.card.imans2, correct: false },
                    { text: uc.card.ans,    correct: true  },
                    { text: uc.card.imans3, correct: false }
                  ].shuffle
                %>

                <% answers.each do |ans| %>
                  <button type="button" class="btn btn-secondary answer-btn" data-answer="<%= ans[:correct] %>">
                    <%= ans[:text] %>
                  </button>
                <% end %>
                <button type="button" class="btn btn-secondary answer-btn" data-answer="false"><%= uc.card.imans1 %></button>
                <button type="button" class="btn btn-secondary answer-btn" data-answer="false"><%= uc.card.imans2 %></button>
                <button type="button" class="btn btn-secondary answer-btn" data-answer="true"><%= uc.card.ans %></button>
                <button type="button" class="btn btn-secondary answer-btn" data-answer="false"><%= uc.card.imans3 %></button>
               <!-- 正解時に表示される解説表示ボタン -->
                <div class="mt-3 text-center">
                  <button type="button" 
                          id="showExplanation<%= index %>" 
                          class="btn btn-info d-none explanation-btn" 
                          data-bs-toggle="modal" 
                          data-bs-target="#geminiModal" 
                          data-question="<%= uc.card.question %>">
                    解説を表示
                  </button>
                </div>
                
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">閉じる</button>
                <p id="result<%= index %>" class="fw-bold text-center"></p>
              </div>
            </div>
          </div>
        </div>
        </div>     
      <% end %>
    </div>
  </div>
<% else %>
  <p class="text-center text-muted">まだカードを所持していません。</p>
<% end %>

<!-- Toast (正解通知用) -->
<div class="position-fixed top-0 end-0 p-3" style="z-index: 1100">
  <div id="answerToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body" id="toastBody">
      正解！
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
  // 回答ボタンのイベントリスナー
  document.querySelectorAll(".answer-btn").forEach(function(button) {
    button.addEventListener("click", function() {
      // 正解かどうかの確認
      if (this.getAttribute("data-answer") === "true") {
        // ユーザーが正解の場合、モーダル内の解説表示ボタンを表示する
        const modalBody = this.closest(".modal-body");
        // ここでは、id属性が "showExplanation" で始まる要素を探す
        const explanationBtn = modalBody.querySelector("[id^='showExplanation']");
        if (explanationBtn) {
          explanationBtn.classList.remove("d-none");
        }
        // 例: 正解通知用のToastを表示する処理などもここで追加可能
      } else {
        // 不正解の場合の処理（例：フィードバックの表示）をここで記述
      }
    });
  });

  // 解説表示ボタンのクリックイベント（.explanation-btn クラスのボタン全般）
  document.querySelectorAll('.explanation-btn').forEach(function(button) {
    button.addEventListener("click", function(event) {
      event.preventDefault();
      // data-question属性から card.question の値を取得
      const question = this.getAttribute("data-question");
      // GeminiTest ページのURLにクエリパラメーターとして追加
      const url = "/gemini/test?question=" + encodeURIComponent(question);
      console.log("GeminiTest URL: ", url);
      // iframe のsrcを設定してページを読み込む
      document.getElementById("geminiIframe").src = url;
      // GeminiTest のポップアップ用モーダルを表示
      var geminiModal = new bootstrap.Modal(document.getElementById("geminiModal"));
      geminiModal.show();
    });
  });
});
</script>


<!-- GeminiTest ポップアップ用モーダル -->
<div class="modal fade" id="geminiModal" tabindex="-1" aria-labelledby="geminiModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="geminiModalLabel">解説の方</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
      </div>
      <div class="modal-body">
        <iframe id="geminiIframe" src="" style="width:100%; height:600px; border:0;"></iframe>
      </div>
    </div>
  </div>
</div>
