<style>
  @import url('https://fonts.googleapis.com/css2?family=DotGothic16&display=swap');
</style>

<h3>探索中... (<%= @investigation.turn_count %> / 3)</h3>

<div class="container mt-4">
 <div class="row row-cols-3 row-cols-md-3 row-cols-lg-3 g-3">
  <% @card.each_with_index do |card, index| %>
   <div class="col">
    <div class="card shadow bg-dark text-white h-100 border-warning" style="border-width: 2px;">
     <a href="#" data-bs-toggle="modal" data-bs-target="#cardModal-investigate-<%= index %>">
      <%= image_tag card.image, class: 'card-img-top', style: 'aspect-ratio: 4 / 5; object-fit: cover;' %>
     </a>
     <div class="card-body p-2 text-center">
      <h6 class="card-title mb-1"><%= card.bunya %></h6>
      <button type="button" class="btn btn-outline-light btn-sm w-100" data-bs-toggle="modal" data-bs-target="#cardModal-investigate-<%= index %>">
       問題を解く
      </button>
     </div>
    </div>
   </div>

   <div class="modal fade" id="cardModal-investigate-<%= index %>" tabindex="-1" aria-labelledby="cardModalLabel-investigate-<%= index %>" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
     <div class="modal-content text-dark">
      <div class="modal-header">
       <h5 class="modal-title" id="cardModalLabel-investigate-<%= index %>"><%= card.bunya %>の問題</h5>
       <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
       <%= image_tag card.image, class: "img-fluid mb-3 rounded" %>
       <p><strong>問題:</strong> <%= card.question %></p>
       <hr>
       <p>回答を選んでください</p>

       <div class="d-grid gap-2">
        <% answers = [
         { text: card.ans, correct: true },
         { text: card.imans1, correct: false },
         { text: card.imans2, correct: false },
         { text: card.imans3, correct: false }
        ].shuffle %>

        <% answers.each do |ans| %>
         <%= form_with url: answer_battle_investigate_path, method: :post, local: true do %>
          <%= hidden_field_tag :card_id, card.id %>
          <%= hidden_field_tag :correct, ans[:correct] %>
          <button type="submit" class="btn btn-outline-secondary w-100 mb-2">
           <%= ans[:text] %>
          </button>
         <% end %>
        <% end %>
       </div>
      </div>
      <div class="modal-footer">
       <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">閉じる</button>
      </div>
     </div>
    </div>
   </div>
  <% end %>
 </div>
</div>