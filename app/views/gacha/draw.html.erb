<style>
  @import url('https://fonts.googleapis.com/css2?family=DotGothic16&display=swap');
</style>

<div id="animation-overlay" style="display: none;">
  <%= image_tag "pack_opening.gif", id: "animation-gif" %>
</div>

<div id="slider-container">
  <div id="slider">
    <span>➡</span>
  </div>
  <div id="slider-label">ガチャを引く</div>
</div>


<div class="position-absolute bottom-0 start-50 translate-middle">
    
    <%= link_to "", draw_ten_path, class: "btn btn-dark btn-lg",style: 'border-color: black; color: black;', id: "100gacha_button"%>
    
</div>


<style>
  #100gacha_button {
    bottom: 0px;
  }
  
  #slider-container {
    width: 300px;
    height: 50px;
    background: #222;
    border-radius: 25px;
    position: relative;
    overflow: hidden;
    user-select: none;
    margin: 20px auto;
    display: flex;
    align-items: center;
    padding: 0 10px;
  }

  #slider {
    width: 50px;
    height: 50px;
    background: linear-gradient(to bottom, #eee, #ccc);
    border-radius: 25px;
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    cursor: grab;
    z-index: 2;
    transition: left 0.3s;
  }

  #slider-label {
    flex: 1;
    text-align: center;
    color: #aaa;
    font-size: 16px;
    z-index: 1;
    pointer-events: none;
  }

  #slider-container.unlocked {
    background: #ffc107;
  }

  #slider-container.unlocked #slider-label {
    color: #000;
  }

  #animation-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 10000;
  }

  #animation-gif {
    max-width: 90%;
    max-height: 90%;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const slider = document.getElementById('slider');
    const container = document.getElementById('slider-container');
    let isDragging = false;
    let startX = 0;

    slider.addEventListener('mousedown', (e) => {
      isDragging = true;
      startX = e.clientX;
    });

    document.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      let dx = e.clientX - startX;
      dx = Math.max(0, Math.min(dx, container.offsetWidth - slider.offsetWidth));
      slider.style.left = dx + 'px';

      if (dx >= container.offsetWidth - slider.offsetWidth - 10) {
        unlock();
      }
    });

    document.addEventListener('mouseup', () => {
      if (!isDragging) return;
      if (!container.classList.contains('unlocked')) {
        slider.style.left = '0px'; // reset
      }
      isDragging = false;
    });

    // 3. unlock関数の中身を修正
    function unlock() {
      // isDraggingをfalseにして、マウスを離したときにリセットされないようにする
      isDragging = false; 
      container.classList.add('unlocked');
      slider.innerHTML = '✓';
      slider.style.left = (container.offsetWidth - slider.offsetWidth) + 'px';
      slider.style.cursor = 'default';
      
      // ページ遷移の前にアニメーションを挟む
      const overlay = document.getElementById('animation-overlay');
      if (overlay) {
        // GIFオーバーレイを表示
        overlay.style.display = 'flex';

        // アニメーションの時間だけ待機 (3秒)
        const animationDuration = 3000; // GIFの長さに合わせて調整してください
        setTimeout(() => {
          // 結果ページへ遷移
          window.location.href = "/gacha/redraw";
        }, animationDuration);
      } else {
        // 念のため、オーバーレイがない場合はすぐに遷移
        window.location.href = "/gacha/redraw";
      }
    }
  });
</script>
